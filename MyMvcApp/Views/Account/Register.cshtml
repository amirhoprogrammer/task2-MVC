@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>ثبت‌نام - کندا ایده</title>
    <style>
        @@font-face {
            font-family: 'IranYekan';
            src: url('/fonts/IranYekan/IRANYekanMedium.ttf') format('truetype');
            font-weight: normal;
            font-style: normal;
        }
        @@font-face {
            font-family: 'IranYekanBold';
            src: url('/fonts/IranYekan/IRANYekanBold.ttf') format('truetype');
            font-weight: bold;
            font-style: normal;
        }
        @@font-face {
            font-family: 'IranYekanLight';
            src: url('/fonts/IranYekan/IRANYekanLight.ttf') format('truetype');
        }
        @@font-face {
            font-family: 'IranYekanExtraBold';
            src: url('/fonts/IranYekan/IRANYekanExtraBold.ttf') format('truetype');
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { display: flex; height: 100vh; font-family: 'IranYekan', Tahoma; }

        .left {
            width: 55%;
            background: #6A50D1;
            color: white;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 40px;
        }
        .left h1 { font-family: 'IranYekanBold'; font-size: 32px; }
        .left p { margin-top: 15px; opacity: 0.9; }

        .right {
            width: 45%;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .form-box {
            width: 380px;
            padding: 40px;
            border-radius: 16px;


        }

        input {
            width: 100%;
            padding: 12px 0;
            margin-bottom: 22px;
            border: none;
            border-bottom: 1.5px solid #ddd;
            border-radius: 0;
            font-size: 15px;
            font-family: 'IranYekan';
            background: transparent;
            outline: none;
            color: #333;
            transition: border-color 0.3s;
        }

        input:focus {
            border-bottom-color: #6A50D1;
        }

        input::placeholder {
            color: #b0b0b0;
            font-family: 'IranYekan';
        }

        .btn {
            width: 60%;
            padding: 13px;
            border: none;
            border-radius: 50px;
            background: #6A50D1;
            color: white;
            font-size: 16px;
            cursor: pointer;
            margin-top: 10px;
            font-family: 'IranYekanExtraBold';
            text-decoration: none;
        }

        .error { color: red; margin-bottom: 15px; text-align: center; }

        .question {
            text-align: center;
            margin-top: 25px;
            margin-bottom: 30px;
            font-family: 'IranYekan';
            font-size: 14px;
        }
        .buttons{
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .password-wrapper {
            position: relative;
            width: 100%;
            margin-bottom: 22px;
        }

        .password-wrapper input {
            width: 100%;
            padding: 12px 40px 12px 0;   
            margin-bottom: 0;
        }

        .toggle-password {
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            font-size: 18px;
            color: #888;
            user-select: none;
            opacity: 0.75;
            transition: opacity 0.2s;
        }

        .toggle-password:hover {
            opacity: 1;
        }
    </style>
</head>
<body>
    <div class="right">
        <div class="form-box">
            @if (TempData["Error"] != null)
            {
                <div class="error">@TempData["Error"]</div>
            }

            <p style="margin-bottom:25px; font-family:'IranYekan';">ساخت حساب کاربری جدید!</p>

            <form method="post" asp-action="Register">
                <input type="text" name="FirstName" placeholder="نام" required />
                <input type="text" name="LastName" placeholder="نام خانوادگی" required />
                <input type="text" name="Username" placeholder="نام کاربری" required />
                <div class="password-wrapper">
                <input type="password" name="Password" id="password" placeholder="کلمه عبور" required />
                <span class="toggle-password" 
                    onmousedown="showPassword()" 
                    onmouseup="hidePassword()" 
                    onmouseleave="hidePassword()">
                    👁
                </span>
            </div>
                <input type="email" name="Email" placeholder="ایمیل" required />
                <input type="text" name="Phone" placeholder="شماره تماس" required />
                <div class="buttons"><button type="submit" class="btn">ثبت‌ نام!!</button></div>
                
            </form>

            <p class="question">آیا حساب کاربری دارید؟</p>
            <div class="buttons"><a asp-action="Login" class="btn">وارد شوید!!</a></div>
            
        </div>
    </div>

    <div class="left">
        <h1>حضور در پروژه‌های بین‌المللی</h1>
        <img src="~/img/world.png" alt="world" style="margin-top:40px; max-width:280px;">
    </div>
    <script>
        function showPassword() {
            document.getElementById('password').type = 'text';
        }
        function hidePassword() {
            document.getElementById('password').type = 'password';
        }
    </script>
</body>
</html>